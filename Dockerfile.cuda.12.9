# Multi-stage build for Scriberr with CUDA 12.9 support (Blackwell GPUs)
# This Dockerfile targets NVIDIA RTX 50-series (Blackwell architecture, sm_120)
# and NVIDIA GB10/GH200 (aarch64 with CUDA)
# For legacy GPUs (GTX 10-series through RTX 40-series), use Dockerfile.cuda instead
# Builds React UI and Go server, then ships with NVIDIA CUDA runtime

########################
# UI build stage
########################
FROM node:20-alpine AS ui-builder
WORKDIR /web

# Install deps and build web/frontend
COPY web/frontend/package*.json ./frontend/
RUN cd frontend \
  && npm ci

COPY web/frontend ./frontend
RUN cd frontend \
  && npm run build


########################
# Go build stage
########################
FROM golang:1.24-bookworm AS go-builder
WORKDIR /src

# Pre-cache modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Copy built UI into embed path
RUN rm -rf internal/web/dist && mkdir -p internal/web
COPY --from=ui-builder /web/frontend/dist internal/web/dist

# Build binary (arch matches builder platform)
RUN CGO_ENABLED=0 \
  go build -o /out/scriberr cmd/server/main.go
# Build CLI binaries (cross-platform)
RUN mkdir -p /out/bin/cli \
  && GOOS=linux GOARCH=amd64 go build -o /out/bin/cli/scriberr-linux-amd64 ./cmd/scriberr-cli \
  && GOOS=darwin GOARCH=amd64 go build -o /out/bin/cli/scriberr-darwin-amd64 ./cmd/scriberr-cli \
  && GOOS=darwin GOARCH=arm64 go build -o /out/bin/cli/scriberr-darwin-arm64 ./cmd/scriberr-cli \
  && GOOS=windows GOARCH=amd64 go build -o /out/bin/cli/scriberr-windows-amd64.exe ./cmd/scriberr-cli


########################
# CTranslate2 CUDA build stage (aarch64 only)
# PyPI only provides CPU-only wheels for aarch64, so we build from source with CUDA
#
# We use CUDA 12.9 devel to match the runtime image AND to support Blackwell SM 12.0/12.1.
# The vendored Thrust/CUB is removed (see below) so we use system CUDA 12.9 Thrust/CUB.
# CUDA_DYNAMIC_LOADING=ON means the library loads CUDA libs at runtime dynamically.
########################
FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04 AS ct2-builder

# Only run this stage on aarch64 — on x86_64, the PyPI wheel already has CUDA support
# Docker will still process this stage but it's fast when cached

# Install system Python 3.12 (for CMake find_package) plus curl for uv installer
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential git wget curl \
       python3 python3-dev python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Install uv and use it to get Python 3.10 for the wheel build.
# The WhisperX venv uses Python 3.10 (managed by uv), so the CT2 wheel
# MUST be cp310, not the system cp312.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
  && /root/.local/bin/uv python install 3.10

# System CMake on Ubuntu 22.04 is too old; install CMake 3.28 which supports sm_90
RUN wget -qO- https://github.com/Kitware/CMake/releases/download/v3.28.6/cmake-3.28.6-linux-aarch64.tar.gz \
  | tar xz --strip-components=1 -C /usr/local

WORKDIR /build

# Clone CTranslate2 and init submodules, then remove vendored Thrust/CUB
# The vendored Thrust/CUB is from an older era and incompatible with any CUDA 12.x;
# removing it forces CMake to use the system CUDA 12.9 Thrust/CUB. We also patch primitives.cu to add missing Thrust includes.
RUN git clone --depth 1 --branch v4.6.0 https://github.com/OpenNMT/CTranslate2.git \
  && cd CTranslate2 \
  && git submodule update --init --depth 1 \
  && rm -rf third_party/thrust \
  && sed -i "1i \#include <thrust/reduce.h>\\n\#include <thrust/extrema.h>" src/cuda/primitives.cu

# Build the C++ library with CUDA support
# CUDA_ARCH_LIST: "8.0;9.0" for CMake compatibility; SM 12.0 added via CUDA_NVCC_FLAGS
# sm_80 (Ampere) + sm_90 (Hopper) + sm_120 (Blackwell/GB10)
# CUDA_DYNAMIC_LOADING=ON so the library loads CUDA at runtime (portable across CUDA versions)
# OPENMP_RUNTIME=COMP uses GNU libgomp instead of Intel libiomp5
# WITH_MKL=OFF since Intel MKL is not available on aarch64
RUN cd CTranslate2 \
  && mkdir build && cd build \
  && cmake .. \
       -DWITH_CUDA=ON \
       -DWITH_CUDNN=ON \
       -DCUDA_DYNAMIC_LOADING=ON \
       -DOPENMP_RUNTIME=COMP \
       -DWITH_MKL=OFF \
       -DCUDA_ARCH_LIST="8.0;9.0" \
       -DCUDA_NVCC_FLAGS="-gencode=arch=compute_120,code=sm_120" \
       -DCMAKE_BUILD_TYPE=Release \
       -DBUILD_CLI=OFF \
       -DCMAKE_INSTALL_PREFIX=/usr/local \
  && make -j$(nproc) \
  && make install

# Build Python wheel
# --no-build-isolation is needed so pip uses the venv's pybind11 instead of
# creating an isolated build env that can't find it
# Use uv-managed Python 3.10 to build the wheel (must match WhisperX venv version)
# --seed flag ensures pip/setuptools/wheel are installed in the venv
RUN cd CTranslate2 \
  && /root/.local/bin/uv venv --python 3.10 --seed /tmp/build-venv \
  && /tmp/build-venv/bin/pip install --upgrade pip setuptools wheel pybind11 \
  && cd python \
  && CTRANSLATE2_ROOT=/usr/local /tmp/build-venv/bin/pip wheel . --no-deps --no-build-isolation -w /wheels

# The wheel will be in /wheels/ctranslate2-*.whl


########################
# CUDA Runtime stage
########################
FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 AS runtime

ENV PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATABASE_PATH=/app/data/scriberr.db \
    UPLOAD_DIR=/app/data/uploads \
    WHISPERX_ENV=/app/whisperx-env \
    APP_ENV=production \
    PUID=1000 \
    PGID=1000 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    # PyTorch CUDA wheel version: cu129 has aarch64 wheels for Blackwell GPUs
    PYTORCH_CUDA_VERSION=cu129

WORKDIR /app

# System deps: curl for uv install, ca-certs, ffmpeg for yt-dlp, git for git+ installs, gosu for user switching
# Ubuntu 24.04 comes with Python 3.12 which works fine with WhisperX
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       curl ca-certificates ffmpeg git gosu unzip \
       build-essential gcc g++ make python3-dev \
       python3 python3-venv python3-pip \
  && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager) directly to system PATH
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
  && cp /root/.local/bin/uv /usr/local/bin/uv \
  && chmod 755 /usr/local/bin/uv \
  && uv --version

# Install yt-dlp standalone binary (required by API handlers for YouTube URL processing)
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
  && chmod a+rx /usr/local/bin/yt-dlp \
  && yt-dlp --version

# Install Deno (JavaScript runtime required for yt-dlp YouTube downloads)
# YouTube now requires JS execution for video cipher decryption
# See: https://github.com/yt-dlp/yt-dlp/issues/14404
RUN curl -fsSL https://deno.land/install.sh | sh \
  && cp /root/.deno/bin/deno /usr/local/bin/deno \
  && chmod 755 /usr/local/bin/deno \
  && deno --version

# Copy pre-built CUDA ctranslate2 wheel from builder stage
# On aarch64 this is a CUDA-enabled wheel; the Go adapter installs it after uv sync
COPY --from=ct2-builder /wheels/ /app/ctranslate2-cuda/

# Copy the CTranslate2 shared libraries needed at runtime
COPY --from=ct2-builder /usr/local/lib/libctranslate2* /usr/local/lib/
RUN ldconfig

# Create default user (will be modified at runtime if needed)
# Use 10001 to avoid conflicts with existing users in CUDA base image
RUN groupadd -g 10001 appuser \
  && useradd -m -u 10001 -g 10001 appuser \
  && mkdir -p /app/data/uploads /app/data/transcripts \
  && chown -R appuser:appuser /app

# Pre-baked model caches: HuggingFace models (~5.3GB), uv package cache (~12GB), torch hub cache
# This eliminates multi-GB downloads on first startup. Models included:
#   - Systran/faster-whisper-large-v3 (2.9GB) - WhisperX transcription
#   - jonatasgrosman/wav2vec2-large-xlsr-53-dutch (2.4GB) - Dutch alignment
#   - pyannote/segmentation-3.0 (5.7MB) - speaker segmentation
#   - pyannote/speaker-diarization-3.1 (28KB) - diarization pipeline config
#   - mistralai/Voxtral-mini (8.8GB) - Voxtral-mini speech-to-text model
#   - mistralai/Voxtral-Small-24B-2507 (~48GB) - Voxtral-small 24B speech-to-text model
# Model cache is now a Docker volume mount, not baked into image
# COPY --chown=appuser:appuser model-cache/dot-cache /home/appuser/.cache/

# Copy binary and entrypoint script
COPY --from=go-builder /out/scriberr /app/scriberr
COPY --from=go-builder /out/bin/cli /app/bin/cli
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Make entrypoint script executable and set up basic permissions
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
  && chown appuser:appuser /app/scriberr

# Expose port and declare volume for persistence
EXPOSE 8080
VOLUME ["/app/data"]

# Start as root to allow user ID changes, entrypoint script will switch users
# Verify uv is available
RUN uv --version

# Use entrypoint script that handles user switching and permissions
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/app/scriberr"]
